# Environment Variables for Shashinda Eshan Portfolio + Payload CMS
# Copy this to .env.local and fill in your actual values

# ─── Payload ───────────────────────────────────────────────
# Generate a strong random string: openssl rand -base64 32
PAYLOAD_SECRET=your-random-secret-here

# ─── Database (Supabase PostgreSQL) ─────────────────────────
# Use the DIRECT connection (port 5432), NOT the pooler (port 6543)
# Found in: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Cloudinary ─────────────────────────────────────────────
# Found at: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── App URL ─────────────────────────────────────────────────
# Locally:
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# On Vercel, set this to: https://your-domain.vercel.app
